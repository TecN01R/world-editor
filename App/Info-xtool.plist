<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the Info.plist that xtool writes (xtool.yml's infoPath). The Xcode
     build sets the same keys in project.yml. -->
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>To scan pages for the companion to read.</string>
	<!-- The companion's model download, and its replies, continue in the background
	     (continued processing tasks, named after the bundle ID: xtool's signing
	     prefixes it with the team ID on the phone). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.tecn01r.worldeditor.companion-download</string>
		<string>XTL-YRQNG56JP3.com.tecn01r.worldeditor.companion-download</string>
		<string>com.tecn01r.worldeditor.companion-reply</string>
		<string>XTL-YRQNG56JP3.com.tecn01r.worldeditor.companion-reply</string>
	</array>
</dict>
</plist>
