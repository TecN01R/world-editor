<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The companion's on-device model needs more than the default memory limit. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- A reply runs on, on the GPU, when the author leaves the app (BackgroundReply). -->
	<key>com.apple.developer.background-tasks.continued-processing.gpu</key>
	<true/>
</dict>
</plist>
